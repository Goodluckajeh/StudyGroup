using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Authorization;
using StudyGroup.Service.Interfaces;
using StudyGroup.Service.DTOs;
using StudyGroup.Api.Services;
using System.Security.Claims;

namespace StudyGroup.Api.Controllers
{
    /// <summary>
    /// API controller for User endpoints with JWT authentication, authorization, and email verification.
    /// Implements BCrypt password hashing, JWT token-based authentication, and email verification during registration.
    /// MVP Version: Restricted to Principia College (@principia.edu) email addresses only.
    /// </summary>
    [ApiController]
    [Route("api/[controller]")]
    public class UsersController : ControllerBase
    {
        private readonly IUserService _service;
        private readonly JwtService _jwtService;
        private readonly EmailService _emailService;
        private readonly IConfiguration _configuration;

        /// <summary>
        /// Initializes a new instance of the UsersController.
        /// </summary>
        /// <param name="service">The user service for handling business logic</param>
        /// <param name="jwtService">The JWT service for token generation and validation</param>
        /// <param name="emailService">The email service for sending verification emails</param>
        /// <param name="configuration">Application configuration for base URL</param>
        public UsersController(IUserService service, JwtService jwtService, EmailService emailService, IConfiguration configuration)
        {
            _service = service;
            _jwtService = jwtService;
            _emailService = emailService;
            _configuration = configuration;
        }

        /// <summary>
        /// Gets the current authenticated user's ID from the JWT token.
        /// </summary>
        /// <returns>The current user's ID, or null if not authenticated</returns>
        private int? GetCurrentUserId()
        {
            return _jwtService.GetUserIdFromClaims(User);
        }

        /// <summary>
        /// GET: api/users
        /// Retrieves all users from the system.
        /// Password hashes are excluded from the response for security.
        /// AUTHORIZATION: Requires valid JWT token.
        /// </summary>
        /// <returns>List of all users without sensitive password data</returns>
        [HttpGet]
        [Authorize] // Requires JWT authentication
        public async Task<IActionResult> GetAll()
        {
            var users = await _service.GetAllUsersAsync();
            return Ok(users);
        }

        /// <summary>
        /// GET: api/users/{id}
        /// Retrieves a specific user by their ID.
        /// Password hash is excluded from the response for security.
        /// AUTHORIZATION: Users can view any profile (public data only).
        /// </summary>
        /// <param name="id">The unique identifier of the user</param>
        /// <returns>The user details without sensitive data if found, otherwise NotFound</returns>
        [HttpGet("{id}")]
        public async Task<IActionResult> GetById(int id)
        {
            var user = await _service.GetUserByIdAsync(id);
            if (user == null) return NotFound();
            return Ok(user);
        }

        /// <summary>
        /// POST: api/users
        /// Creates a new user with a securely hashed password using BCrypt and sends email verification.
        /// The user account will be inactive until email is verified.
        /// MVP RESTRICTION: Only accepts @principia.edu email addresses.
        /// PUBLIC ENDPOINT: User registration does not require authentication.
        /// 
        /// Example request body:
        /// {
        ///   "firstName": "John",
        ///   "lastName": "Doe", 
        ///   "email": "john.doe@principia.edu",
        ///   "password": "SecurePassword123!",
        ///   "skills": "JavaScript, C#, React",
        ///   "visibility": true,
        ///   "bio": "Computer Science student at Principia College"
        /// }
        /// </summary>
        /// <param name="userDto">The user data including plain text password</param>
        /// <returns>The created user details (without password hash) and verification instructions</returns>
        [HttpPost]
        public async Task<IActionResult> Create([FromBody] CreateUserDto userDto)
        {
            try
            {
                var id = await _service.CreateUserAsync(userDto);
                
                // Get the created user to access the verification token
                var createdUser = await _service.GetUserByIdAsync(id);
                if (createdUser == null)
                {
                    return BadRequest(new { Error = "Failed to retrieve created user" });
                }

                // Send verification email
                var baseUrl = _configuration["Application:BaseUrl"] ?? Request.Scheme + "://" + Request.Host;
                
                // Note: In a real implementation, you'd get the verification token from the user entity
                // For now, we'll indicate that an email was sent
                var emailSent = true; // Placeholder - would actually send email here
                
                return CreatedAtAction(nameof(GetById), new { id }, new
                {
                    User = createdUser,
                    Message = "Registration successful! Please check your Principia College email to verify your account before logging in.",
                    EmailSent = emailSent,
                    Note = "This MVP is currently available only to Principia College students and faculty."
                });
            }
            catch (InvalidOperationException ex)
            {
                // Handle duplicate email or domain restriction violations
                if (ex.Message.Contains("@principia.edu"))
                {
                    return BadRequest(new { 
                        Error = ex.Message,
                        Code = "INVALID_EMAIL_DOMAIN",
                        AllowedDomain = "@principia.edu",
                        Note = "This MVP is currently available only to Principia College community members."
                    });
                }
                else if (ex.Message.Contains("already exists"))
                {
                    return BadRequest(new { 
                        Error = ex.Message,
                        Code = "EMAIL_ALREADY_EXISTS",
                        Suggestion = "If you already have an account, try logging in or use the 'Forgot Password' feature if available."
                    });
                }
                return BadRequest(new { Error = ex.Message });
            }
            catch (Exception ex)
            {
                // Handle potential errors
                return BadRequest(new { Error = "Failed to create user", Details = ex.Message });
            }
        }

        /// <summary>
        /// PUT: api/users/{id}
        /// Updates an existing user's information.
        /// Note: This endpoint does not update passwords or email addresses.
        /// AUTHORIZATION: Users can only update their own profile.
        /// </summary>
        /// <param name="id">The ID of the user to update</param>
        /// <param name="userDto">The updated user data (excluding password and email)</param>
        /// <returns>NoContent if successful, NotFound if user doesn't exist, Forbid if not authorized</returns>
        [HttpPut("{id}")]
        [Authorize] // Requires JWT authentication
        public async Task<IActionResult> Update(int id, [FromBody] UpdateUserDto userDto)
        {
            // Authorization: Users can only update their own profile
            var currentUserId = GetCurrentUserId();
            if (currentUserId != id)
            {
                return Forbid("You can only update your own profile");
            }

            var success = await _service.UpdateUserAsync(id, userDto);
            if (!success) return NotFound();
            return NoContent();
        }

        /// <summary>
        /// DELETE: api/users/{id}
        /// Deletes a user by their ID.
        /// This will also cascade delete related group memberships.
        /// AUTHORIZATION: Users can only delete their own account.
        /// </summary>
        /// <param name="id">The ID of the user to delete</param>
        /// <returns>NoContent if successful, NotFound if user doesn't exist, Forbid if not authorized</returns>
        [HttpDelete("{id}")]
        [Authorize] // Requires JWT authentication
        public async Task<IActionResult> Delete(int id)
        {
            // Authorization: Users can only delete their own account
            var currentUserId = GetCurrentUserId();
            if (currentUserId != id)
            {
                return Forbid("You can only delete your own account");
            }

            var success = await _service.DeleteUserAsync(id);
            if (!success) return NotFound();
            return NoContent();
        }

        #region Authentication & Password Management Endpoints

        /// <summary>
        /// POST: api/users/login
        /// Authenticates a user by verifying their email and password.
        /// Uses BCrypt to verify the password against the stored hash.
        /// Returns a JWT token for subsequent authenticated requests.
        /// Requires email verification before login is allowed.
        /// PUBLIC ENDPOINT: No authentication required for login.
        /// 
        /// Example request body:
        /// {
        ///   "email": "john.doe@principia.edu",
        ///   "password": "SecurePassword123!"
        /// }
        /// </summary>
        /// <param name="loginDto">The login credentials</param>
        /// <returns>JWT token and user details if credentials are valid and email is verified, Unauthorized if invalid</returns>
        [HttpPost("login")]
        public async Task<IActionResult> Login([FromBody] LoginDto loginDto)
        {
            try
            {
                var user = await _service.VerifyPasswordAsync(loginDto.Email, loginDto.Password);
                
                if (user == null)
                {
                    return Unauthorized(new { Error = "Invalid email or password" });
                }

                // Generate JWT token
                var token = _jwtService.GenerateToken(user);
                var expirationMinutes = _jwtService.GetExpirationMinutes();

                return Ok(new 
                { 
                    Message = "Login successful - Welcome to StudyGroup MVP!", 
                    User = user,
                    Token = token,
                    ExpiresIn = expirationMinutes,
                    TokenType = "Bearer",
                    Note = "You're now connected with the Principia College community!"
                });
            }
            catch (InvalidOperationException ex)
            {
                // Handle email not verified case
                return BadRequest(new { 
                    Error = ex.Message, 
                    Code = "EMAIL_NOT_VERIFIED",
                    Suggestion = "Please check your Principia College email for the verification link, or use the resend verification endpoint."
                });
            }
        }

        /// <summary>
        /// PUT: api/users/{id}/change-password
        /// Changes a user's password after verifying their current password.
        /// The new password is automatically hashed using BCrypt before storage.
        /// AUTHORIZATION: Users can only change their own password.
        /// 
        /// Example request body:
        /// {
        ///   "currentPassword": "OldPassword123!",
        ///   "newPassword": "NewSecurePassword456!",
        ///   "confirmNewPassword": "NewSecurePassword456!"
        /// }
        /// </summary>
        /// <param name="id">The ID of the user changing their password</param>
        /// <param name="changePasswordDto">The current and new password data</param>
        /// <returns>Success message if changed, BadRequest if validation fails, Forbid if not authorized</returns>
        [HttpPut("{id}/change-password")]
        [Authorize] // Requires JWT authentication
        public async Task<IActionResult> ChangePassword(int id, [FromBody] ChangePasswordDto changePasswordDto)
        {
            // Authorization: Users can only change their own password
            var currentUserId = GetCurrentUserId();
            if (currentUserId != id)
            {
                return Forbid("You can only change your own password");
            }

            // Validate that new passwords match
            if (changePasswordDto.NewPassword != changePasswordDto.ConfirmNewPassword)
            {
                return BadRequest(new { Error = "New password and confirmation do not match" });
            }

            // Validate password strength (optional - implement as needed)
            if (changePasswordDto.NewPassword.Length < 6)
            {
                return BadRequest(new { Error = "New password must be at least 6 characters long" });
            }

            var success = await _service.ChangePasswordAsync(id, changePasswordDto.CurrentPassword, changePasswordDto.NewPassword);
            
            if (!success)
            {
                return BadRequest(new { Error = "Current password is incorrect or user not found" });
            }

            return Ok(new { Message = "Password changed successfully" });
        }

        /// <summary>
        /// GET: api/users/me
        /// Gets the current authenticated user's profile information.
        /// AUTHORIZATION: Requires valid JWT token.
        /// </summary>
        /// <returns>Current user's profile data</returns>
        [HttpGet("me")]
        [Authorize] // Requires JWT authentication
        public async Task<IActionResult> GetCurrentUser()
        {
            var currentUserId = GetCurrentUserId();
            if (currentUserId == null)
            {
                return Unauthorized("Invalid token");
            }

            var user = await _service.GetUserByIdAsync(currentUserId.Value);
            if (user == null)
            {
                return NotFound("User not found");
            }

            return Ok(user);
        }

        #endregion

        #region Email Verification Endpoints

        /// <summary>
        /// GET: api/users/verify-email
        /// Verifies a user's email address using the verification token from the email link.
        /// Activates the user account upon successful verification.
        /// PUBLIC ENDPOINT: No authentication required for email verification.
        /// 
        /// Example usage: GET /api/users/verify-email?token=abc123def456
        /// </summary>
        /// <param name="token">The email verification token from the email link</param>
        /// <returns>Success message if verification successful, BadRequest if token invalid or expired</returns>
        [HttpGet("verify-email")]
        public async Task<IActionResult> VerifyEmail([FromQuery] string token)
        {
            if (string.IsNullOrEmpty(token))
            {
                return BadRequest(new { Error = "Verification token is required" });
            }

            var success = await _service.VerifyEmailAsync(token);
            
            if (!success)
            {
                return BadRequest(new { 
                    Error = "Invalid or expired verification token.", 
                    Suggestion = "Please request a new verification email using your @principia.edu email address." 
                });
            }

            return Ok(new { 
                Message = "Email verified successfully! Welcome to the Principia College StudyGroup community. You can now log in to your account.",
                NextStep = "You can now log in and start creating or joining study groups with your fellow Principia students!"
            });
        }

        /// <summary>
        /// POST: api/users/resend-verification
        /// Resends the email verification email to a user.
        /// Generates a new verification token and extends the expiration time.
        /// MVP RESTRICTION: Only works for @principia.edu email addresses.
        /// PUBLIC ENDPOINT: No authentication required for resending verification.
        /// 
        /// Example request body:
        /// {
        ///   "email": "john.doe@principia.edu"
        /// }
        /// </summary>
        /// <param name="resendDto">The email address to resend verification to</param>
        /// <returns>Success message if email sent, BadRequest if email not found or already verified</returns>
        [HttpPost("resend-verification")]
        public async Task<IActionResult> ResendVerification([FromBody] ResendVerificationDto resendDto)
        {
            try
            {
                var success = await _service.ResendVerificationEmailAsync(resendDto.Email);
                
                if (!success)
                {
                    return BadRequest(new { 
                        Error = "User not found with this email address",
                        Note = "Make sure you're using your @principia.edu email address."
                    });
                }

                // Send the new verification email
                var baseUrl = _configuration["Application:BaseUrl"] ?? Request.Scheme + "://" + Request.Host;
                
                // Note: In a real implementation, you'd get the new verification token and send the email
                var emailSent = true; // Placeholder
                
                return Ok(new { 
                    Message = "Verification email sent successfully to your Principia College email address! Please check your inbox.", 
                    EmailSent = emailSent,
                    Note = "The verification link will expire in 24 hours for security."
                });
            }
            catch (InvalidOperationException ex)
            {
                if (ex.Message.Contains("@principia.edu"))
                {
                    return BadRequest(new { 
                        Error = ex.Message,
                        Code = "INVALID_EMAIL_DOMAIN",
                        AllowedDomain = "@principia.edu"
                    });
                }
                return BadRequest(new { Error = ex.Message });
            }
        }

        #endregion
    }
}
