using StudyGroup.Service.DTOs;

namespace StudyGroup.Service.Validation
{
    /// <summary>
    /// Validator for user-related operations.
    /// Contains all business logic validation rules for users.
    /// </summary>
    public class UserValidator
    {
        /// <summary>
        /// Validates user creation data.
        /// </summary>
        /// <param name="userDto">The user data to validate</param>
        /// <returns>Validation result with errors if any</returns>
        public ValidationResult ValidateCreate(CreateUserDto userDto)
        {
            var result = new ValidationResult();

            // Required field validation
            if (string.IsNullOrWhiteSpace(userDto.FirstName))
                result.AddError("FirstName", "First name is required");

            if (string.IsNullOrWhiteSpace(userDto.LastName))
                result.AddError("LastName", "Last name is required");

            if (string.IsNullOrWhiteSpace(userDto.Email))
                result.AddError("Email", "Email is required");

            if (string.IsNullOrWhiteSpace(userDto.Password))
                result.AddError("Password", "Password is required");

            // Email format validation
            if (!string.IsNullOrWhiteSpace(userDto.Email) && !IsValidEmail(userDto.Email))
                result.AddError("Email", "Invalid email format");

            // Password strength validation
            if (!string.IsNullOrWhiteSpace(userDto.Password))
            {
                var passwordValidation = ValidatePassword(userDto.Password);
                if (!passwordValidation.IsValid)
                {
                    foreach (var error in passwordValidation.Errors)
                        result.AddError("Password", error.Value);
                }
            }

            // Name length validation
            if (!string.IsNullOrWhiteSpace(userDto.FirstName) && userDto.FirstName.Length > 50)
                result.AddError("FirstName", "First name cannot exceed 50 characters");

            if (!string.IsNullOrWhiteSpace(userDto.LastName) && userDto.LastName.Length > 50)
                result.AddError("LastName", "Last name cannot exceed 50 characters");

            // Bio length validation
            if (!string.IsNullOrWhiteSpace(userDto.Bio) && userDto.Bio.Length > 500)
                result.AddError("Bio", "Bio cannot exceed 500 characters");

            // Skills validation
            if (!string.IsNullOrWhiteSpace(userDto.Skills))
            {
                var skillsValidation = ValidateSkills(userDto.Skills);
                if (!skillsValidation.IsValid)
                {
                    foreach (var error in skillsValidation.Errors)
                        result.AddError("Skills", error.Value);
                }
            }

            return result;
        }

        /// <summary>
        /// Validates user update data.
        /// </summary>
        /// <param name="userDto">The user data to validate</param>
        /// <returns>Validation result with errors if any</returns>
        public ValidationResult ValidateUpdate(UpdateUserDto userDto)
        {
            var result = new ValidationResult();

            // Required field validation
            if (string.IsNullOrWhiteSpace(userDto.FirstName))
                result.AddError("FirstName", "First name is required");

            if (string.IsNullOrWhiteSpace(userDto.LastName))
                result.AddError("LastName", "Last name is required");

            // Name length validation
            if (!string.IsNullOrWhiteSpace(userDto.FirstName) && userDto.FirstName.Length > 50)
                result.AddError("FirstName", "First name cannot exceed 50 characters");

            if (!string.IsNullOrWhiteSpace(userDto.LastName) && userDto.LastName.Length > 50)
                result.AddError("LastName", "Last name cannot exceed 50 characters");

            // Bio length validation
            if (!string.IsNullOrWhiteSpace(userDto.Bio) && userDto.Bio.Length > 500)
                result.AddError("Bio", "Bio cannot exceed 500 characters");

            // Skills validation
            if (!string.IsNullOrWhiteSpace(userDto.Skills))
            {
                var skillsValidation = ValidateSkills(userDto.Skills);
                if (!skillsValidation.IsValid)
                {
                    foreach (var error in skillsValidation.Errors)
                        result.AddError("Skills", error.Value);
                }
            }

            return result;
        }

        /// <summary>
        /// Validates password change data.
        /// </summary>
        /// <param name="changePasswordDto">The password change data to validate</param>
        /// <returns>Validation result with errors if any</returns>
        public ValidationResult ValidatePasswordChange(ChangePasswordDto changePasswordDto)
        {
            var result = new ValidationResult();

            // Required field validation
            if (string.IsNullOrWhiteSpace(changePasswordDto.CurrentPassword))
                result.AddError("CurrentPassword", "Current password is required");

            if (string.IsNullOrWhiteSpace(changePasswordDto.NewPassword))
                result.AddError("NewPassword", "New password is required");

            if (string.IsNullOrWhiteSpace(changePasswordDto.ConfirmNewPassword))
                result.AddError("ConfirmNewPassword", "Password confirmation is required");

            // Password confirmation validation
            if (!string.IsNullOrWhiteSpace(changePasswordDto.NewPassword) && 
                !string.IsNullOrWhiteSpace(changePasswordDto.ConfirmNewPassword) &&
                changePasswordDto.NewPassword != changePasswordDto.ConfirmNewPassword)
            {
                result.AddError("ConfirmNewPassword", "New password and confirmation do not match");
            }

            // New password strength validation
            if (!string.IsNullOrWhiteSpace(changePasswordDto.NewPassword))
            {
                var passwordValidation = ValidatePassword(changePasswordDto.NewPassword);
                if (!passwordValidation.IsValid)
                {
                    foreach (var error in passwordValidation.Errors)
                        result.AddError("NewPassword", error.Value);
                }
            }

            // Ensure new password is different from current
            if (!string.IsNullOrWhiteSpace(changePasswordDto.CurrentPassword) &&
                !string.IsNullOrWhiteSpace(changePasswordDto.NewPassword) &&
                changePasswordDto.CurrentPassword == changePasswordDto.NewPassword)
            {
                result.AddError("NewPassword", "New password must be different from current password");
            }

            return result;
        }

        #region Private Helper Methods

        /// <summary>
        /// Validates password strength requirements.
        /// </summary>
        private ValidationResult ValidatePassword(string password)
        {
            var result = new ValidationResult();

            if (password.Length < 8)
                result.AddError("Length", "Password must be at least 8 characters long");

            if (password.Length > 128)
                result.AddError("Length", "Password cannot exceed 128 characters");

            if (!password.Any(char.IsDigit))
                result.AddError("Digits", "Password must contain at least one number");

            if (!password.Any(char.IsLetter))
                result.AddError("Letters", "Password must contain at least one letter");

            if (!password.Any(c => char.IsUpper(c)))
                result.AddError("Uppercase", "Password must contain at least one uppercase letter");

            if (!password.Any(c => char.IsLower(c)))
                result.AddError("Lowercase", "Password must contain at least one lowercase letter");

            // Check for common weak passwords
            var weakPasswords = new[] { "password", "12345678", "qwerty123", "admin123" };
            if (weakPasswords.Any(weak => password.ToLowerInvariant().Contains(weak)))
                result.AddError("Weakness", "Password contains common weak patterns");

            return result;
        }

        /// <summary>
        /// Validates skills format and content.
        /// </summary>
        private ValidationResult ValidateSkills(string skills)
        {
            var result = new ValidationResult();

            if (skills.Length > 1000)
                result.AddError("Length", "Skills cannot exceed 1000 characters");

            // Parse and validate individual skills
            var skillList = skills.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                 .Select(s => s.Trim())
                                 .Where(s => !string.IsNullOrWhiteSpace(s))
                                 .ToList();

            if (skillList.Count > 20)
                result.AddError("Count", "Cannot have more than 20 skills");

            foreach (var skill in skillList)
            {
                if (skill.Length > 50)
                    result.AddError("SkillLength", $"Skill '{skill}' exceeds 50 characters");

                if (skill.Length < 2)
                    result.AddError("SkillLength", $"Skill '{skill}' is too short (minimum 2 characters)");
            }

            return result;
        }

        /// <summary>
        /// Validates email format.
        /// </summary>
        private bool IsValidEmail(string email)
        {
            try
            {
                var addr = new System.Net.Mail.MailAddress(email);
                return addr.Address == email;
            }
            catch
            {
                return false;
            }
        }

        #endregion
    }
}