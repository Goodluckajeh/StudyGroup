using StudyGroup.Service.Interfaces;
using StudyGroup.Service.DTOs;
using StudyGroup.Data.Interfaces;

namespace StudyGroup.Service.Services
{
    /// <summary>
    /// Service for automatically managing tags based on user skills and study group courses.
    /// Handles the creation and synchronization of tags when users update skills or study groups are created.
    /// </summary>
    public class AutoTaggingService
    {
        private readonly ITagService _tagService;
        private readonly IEntityTypeService _entityTypeService;
        private readonly IUserService _userService;

        // Entity type constants - these should match your EntityType table
        private const int USER_ENTITY_TYPE_ID = 1; // Assuming 1 = User in EntityType table
        private const int STUDYGROUP_ENTITY_TYPE_ID = 2; // Assuming 2 = StudyGroup in EntityType table

        public AutoTaggingService(ITagService tagService, IEntityTypeService entityTypeService, IUserService userService)
        {
            _tagService = tagService;
            _entityTypeService = entityTypeService;
            _userService = userService;
        }

        /// <summary>
        /// Updates tags for a user based on their skills.
        /// Removes old skill tags and creates new ones.
        /// </summary>
        /// <param name="userId">The user ID</param>
        /// <param name="skills">Comma-separated skills string</param>
        public async Task UpdateUserSkillTagsAsync(int userId, string? skills)
        {
            // Remove existing skill tags for this user
            await RemoveTagsForEntityAsync(userId, USER_ENTITY_TYPE_ID);

            // If no skills provided, we're done
            if (string.IsNullOrWhiteSpace(skills))
                return;

            // Parse skills and create tags
            var skillList = ParseSkills(skills);
            foreach (var skill in skillList)
            {
                await CreateTagAsync(skill.Trim(), USER_ENTITY_TYPE_ID, userId);
            }
        }

        /// <summary>
        /// Updates tags for a study group based on its course.
        /// </summary>
        /// <param name="studyGroupId">The study group ID</param>
        /// <param name="courseName">The course name</param>
        public async Task UpdateStudyGroupCourseTagsAsync(int studyGroupId, string courseName)
        {
            // Remove existing course tags for this study group
            await RemoveTagsForEntityAsync(studyGroupId, STUDYGROUP_ENTITY_TYPE_ID);

            // Create tags based on course name
            var courseTags = ParseCourseTags(courseName);
            foreach (var tag in courseTags)
            {
                await CreateTagAsync(tag.Trim(), STUDYGROUP_ENTITY_TYPE_ID, studyGroupId);
            }
        }

        /// <summary>
        /// Finds study groups that match a user's skill tags.
        /// </summary>
        /// <param name="userId">The user ID</param>
        /// <returns>List of study group IDs that match user's skills</returns>
        public async Task<IEnumerable<int>> FindMatchingStudyGroupsAsync(int userId)
        {
            // Get user's skill tags
            var userTags = await _tagService.GetTagsByEntityAsync(USER_ENTITY_TYPE_ID, userId);
            var userSkills = userTags.Select(t => t.Name.ToLowerInvariant()).ToHashSet();

            if (!userSkills.Any())
                return new List<int>();

            // Get all study group tags
            var allStudyGroupTags = await GetAllTagsForEntityTypeAsync(STUDYGROUP_ENTITY_TYPE_ID);

            // Find study groups with matching tags
            var matchingGroupIds = allStudyGroupTags
                .Where(tag => userSkills.Contains(tag.Name.ToLowerInvariant()))
                .Select(tag => tag.EntityId)
                .Distinct()
                .ToList();

            return matchingGroupIds;
        }

        /// <summary>
        /// Finds users that have skills matching a study group's course tags.
        /// </summary>
        /// <param name="studyGroupId">The study group ID</param>
        /// <returns>List of user IDs with matching skills</returns>
        public async Task<IEnumerable<int>> FindUsersWithMatchingSkillsAsync(int studyGroupId)
        {
            // Get study group's course tags
            var groupTags = await _tagService.GetTagsByEntityAsync(STUDYGROUP_ENTITY_TYPE_ID, studyGroupId);
            var courseTopics = groupTags.Select(t => t.Name.ToLowerInvariant()).ToHashSet();

            if (!courseTopics.Any())
                return new List<int>();

            // Get all user skill tags
            var allUserTags = await GetAllTagsForEntityTypeAsync(USER_ENTITY_TYPE_ID);

            // Find users with matching skills
            var matchingUserIds = allUserTags
                .Where(tag => courseTopics.Contains(tag.Name.ToLowerInvariant()))
                .Select(tag => tag.EntityId)
                .Distinct()
                .ToList();

            return matchingUserIds;
        }

        #region Private Helper Methods

        /// <summary>
        /// Parses a comma-separated skills string into individual skills.
        /// </summary>
        private List<string> ParseSkills(string skills)
        {
            return skills.Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(s => s.Trim())
                        .Where(s => !string.IsNullOrWhiteSpace(s))
                        .ToList();
        }

        /// <summary>
        /// Parses a course name to extract relevant tags.
        /// Examples: "Introduction to Psychology" → ["Psychology", "Introduction"]
        /// "Advanced Calculus II" → ["Calculus", "Advanced", "Mathematics"]
        /// </summary>
        private List<string> ParseCourseTags(string courseName)
        {
            var tags = new List<string>();

            // Add the full course name as a tag
            tags.Add(courseName);

            // Extract subject keywords
            var courseWords = courseName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            
            // Subject mapping - add more as needed
            var subjectMappings = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase)
            {
                {"Psychology", new List<string> {"Psychology", "Social Science"}},
                {"Biology", new List<string> {"Biology", "Life Science", "Science"}},
                {"Chemistry", new List<string> {"Chemistry", "Physical Science", "Science"}},
                {"Physics", new List<string> {"Physics", "Physical Science", "Science"}},
                {"Calculus", new List<string> {"Calculus", "Mathematics", "Math"}},
                {"Algebra", new List<string> {"Algebra", "Mathematics", "Math"}},
                {"Statistics", new List<string> {"Statistics", "Mathematics", "Math", "Data Analysis"}},
                {"Computer", new List<string> {"Computer Science", "Programming", "Technology"}},
                {"Programming", new List<string> {"Programming", "Computer Science", "Technology"}},
                {"History", new List<string> {"History", "Social Science"}},
                {"English", new List<string> {"English", "Literature", "Writing"}},
                {"Literature", new List<string> {"Literature", "English", "Reading"}},
                {"Art", new List<string> {"Art", "Creative Arts", "Visual Arts"}},
                {"Music", new List<string> {"Music", "Performing Arts"}},
                {"Theatre", new List<string> {"Theatre", "Performing Arts", "Drama"}},
                {"Economics", new List<string> {"Economics", "Business", "Social Science"}},
                {"Business", new List<string> {"Business", "Management", "Economics"}},
                {"Philosophy", new List<string> {"Philosophy", "Critical Thinking"}}
            };

            // Add level indicators
            foreach (var word in courseWords)
            {
                if (word.Equals("Introduction", StringComparison.OrdinalIgnoreCase) || 
                    word.Equals("Intro", StringComparison.OrdinalIgnoreCase))
                {
                    tags.Add("Beginner");
                    tags.Add("Introduction");
                }
                else if (word.Equals("Advanced", StringComparison.OrdinalIgnoreCase))
                {
                    tags.Add("Advanced");
                }
                else if (word.Equals("Intermediate", StringComparison.OrdinalIgnoreCase))
                {
                    tags.Add("Intermediate");
                }

                // Check if word matches a subject
                foreach (var mapping in subjectMappings)
                {
                    if (word.Contains(mapping.Key, StringComparison.OrdinalIgnoreCase))
                    {
                        tags.AddRange(mapping.Value);
                    }
                }
            }

            return tags.Distinct().ToList();
        }

        /// <summary>
        /// Creates a tag for an entity, avoiding duplicates.
        /// </summary>
        private async Task CreateTagAsync(string name, int entityTypeId, int entityId)
        {
            try
            {
                var createTagDto = new CreateTagDto
                {
                    Name = name,
                    EntityTypeId = entityTypeId,
                    EntityId = entityId
                };

                await _tagService.CreateTagAsync(createTagDto);
            }
            catch (Exception)
            {
                // Tag might already exist - that's okay
            }
        }

        /// <summary>
        /// Removes all tags for a specific entity.
        /// </summary>
        private async Task RemoveTagsForEntityAsync(int entityId, int entityTypeId)
        {
            var existingTags = await _tagService.GetTagsByEntityAsync(entityTypeId, entityId);
            foreach (var tag in existingTags)
            {
                await _tagService.DeleteTagAsync(tag.TagId);
            }
        }

        /// <summary>
        /// Gets all tags for a specific entity type.
        /// </summary>
        private async Task<IEnumerable<TagDto>> GetAllTagsForEntityTypeAsync(int entityTypeId)
        {
            // This would need to be implemented in ITagService
            // For now, we'll get all tags and filter (not ideal for performance)
            var allTags = await _tagService.GetAllTagsAsync();
            return allTags.Where(t => t.EntityTypeId == entityTypeId);
        }

        #endregion
    }
}