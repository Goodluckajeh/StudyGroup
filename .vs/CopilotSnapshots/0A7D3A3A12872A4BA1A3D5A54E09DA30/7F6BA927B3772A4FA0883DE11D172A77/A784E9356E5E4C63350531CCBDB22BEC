using System.Collections.Generic;
using System.Threading.Tasks;
using StudyGroup.Data.Models;

namespace StudyGroup.Data.Interfaces
{
    // Interface for GroupMember repository, defines CRUD operations
    public interface IGroupMemberRepository
    {
        // Basic CRUD operations
        Task<IEnumerable<GroupMember>> GetAllAsync();
        Task<GroupMember?> GetByIdAsync(int groupMemberId);
        Task<int> CreateAsync(GroupMember groupMember);
        Task<bool> UpdateAsync(GroupMember groupMember);
        Task<bool> DeleteAsync(int groupMemberId);

        // Specialized queries for membership management
        Task<IEnumerable<GroupMember>> GetByGroupIdAsync(int groupId);
        Task<IEnumerable<GroupMember>> GetByUserIdAsync(int userId);
        Task<IEnumerable<GroupMember>> GetByGroupIdAndStatusAsync(int groupId, int statusId);
        Task<GroupMember?> GetByGroupIdAndUserIdAsync(int groupId, int userId);
    }
}
