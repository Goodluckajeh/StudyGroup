using System.Collections.Generic;
using System.Data;
using System.Threading.Tasks;
using Dapper;
using StudyGroup.Data.Interfaces;
using StudyGroup.Data.Models;
using StudyGroup.Data.SqlQueries;

namespace StudyGroup.Data.Repositories
{
    public class StudyGroupRepository : IStudyGroupRepository
    {
        private readonly IDbConnection _dbConnection;

        public StudyGroupRepository(IDbConnection dbConnection)
        {
            _dbConnection = dbConnection;
        }

        public async Task<IEnumerable<Models.StudyGroup>> GetAllAsync()
        {
            return await _dbConnection.QueryAsync<Models.StudyGroup>(StudyGroupSql.GetAll);
        }

        public async Task<Models.StudyGroup?> GetByIdAsync(int groupId)
        {
            return await _dbConnection.QueryFirstOrDefaultAsync<Models.StudyGroup>(StudyGroupSql.GetById, new { GroupId = groupId });
        }

        public async Task<int> CreateAsync(Models.StudyGroup group)
        {
            return await _dbConnection.QuerySingleAsync<int>(StudyGroupSql.Insert, group);
        }

        public async Task<bool> UpdateAsync(Models.StudyGroup group)
        {
            var affected = await _dbConnection.ExecuteAsync(StudyGroupSql.Update, group);
            return affected > 0;
        }

        public async Task<bool> DeleteAsync(int groupId)
        {
            var affected = await _dbConnection.ExecuteAsync(StudyGroupSql.Delete, new { GroupId = groupId });
            return affected > 0;
        }
    }
}
