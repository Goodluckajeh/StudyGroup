using System.Collections.Generic;
using System.Threading.Tasks;
using StudyGroup.Service.DTOs;

namespace StudyGroup.Service.Interfaces
{
    /// <summary>
    /// Interface for User service, defines business logic methods.
    /// Includes secure password management with BCrypt hashing and email verification.
    /// </summary>
    public interface IUserService
    {
        // Basic CRUD operations
        Task<IEnumerable<UserDto>> GetAllUsersAsync();
        Task<UserDto?> GetUserByIdAsync(int userId);
        Task<int> CreateUserAsync(CreateUserDto userDto);
        Task<bool> UpdateUserAsync(int userId, UpdateUserDto userDto);
        Task<bool> DeleteUserAsync(int userId);

        // Password management methods
        Task<UserDto?> VerifyPasswordAsync(string email, string password);
        Task<bool> ChangePasswordAsync(int userId, string currentPassword, string newPassword);

        // Email verification methods
        Task<bool> VerifyEmailAsync(string verificationToken);
        Task<bool> ResendVerificationEmailAsync(string email);
    }
}
