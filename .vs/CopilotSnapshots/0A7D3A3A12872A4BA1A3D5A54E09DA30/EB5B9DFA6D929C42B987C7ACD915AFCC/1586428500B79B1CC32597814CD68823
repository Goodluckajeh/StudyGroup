using System.Collections.Generic;
using System.Threading.Tasks;
using StudyGroup.Data.Models;
using StudyGroup.Data.Interfaces;
using StudyGroup.Service.Interfaces;
using StudyGroup.Service.DTOs;
using System.Linq;

namespace StudyGroup.Service.Services
{
    // Implements IEntityTypeService, contains business logic for entity types
    public class EntityTypeService : IEntityTypeService
    {
        private readonly IEntityTypeRepository _repository;

        // Injects the entity type repository
        public EntityTypeService(IEntityTypeRepository repository)
        {
            _repository = repository;
        }

        // Maps EntityType to EntityTypeDto
        private EntityTypeDto MapToDto(EntityType entityType) => new EntityTypeDto
        {
            EntityTypeId = entityType.EntityTypeId,
            EntityTypeName = entityType.EntityTypeName
        };

        // Gets all entity types
        public async Task<IEnumerable<EntityTypeDto>> GetAllEntityTypesAsync()
        {
            var types = await _repository.GetAllAsync();
            return types.Select(MapToDto);
        }

        // Gets an entity type by ID
        public async Task<EntityTypeDto?> GetEntityTypeByIdAsync(int entityTypeId)
        {
            var type = await _repository.GetByIdAsync(entityTypeId);
            return type == null ? null : MapToDto(type);
        }

        // Creates a new entity type
        public async Task<int> CreateEntityTypeAsync(CreateEntityTypeDto entityTypeDto)
        {
            var entityType = new EntityType
            {
                EntityTypeName = entityTypeDto.EntityTypeName
            };
            return await _repository.CreateAsync(entityType);
        }

        // Updates an existing entity type
        public async Task<bool> UpdateEntityTypeAsync(int entityTypeId, UpdateEntityTypeDto entityTypeDto)
        {
            var entityType = await _repository.GetByIdAsync(entityTypeId);
            if (entityType == null) return false;
            entityType.EntityTypeName = entityTypeDto.EntityTypeName;
            return await _repository.UpdateAsync(entityType);
        }

        // Deletes an entity type by ID
        public async Task<bool> DeleteEntityTypeAsync(int entityTypeId)
        {
            return await _repository.DeleteAsync(entityTypeId);
        }
    }
}
