namespace StudyGroup.Data.SqlQueries
{
    // Contains SQL queries for MembershipStatus entity CRUD operations
    public static class MembershipStatusSql
    {
        public const string GetAll = @"SELECT * FROM membership_status";
        public const string GetById = @"SELECT * FROM membership_status WHERE status_id = @StatusId";
        public const string Insert = @"INSERT INTO membership_status (status_name) VALUES (@StatusName); SELECT CAST(SCOPE_IDENTITY() as int);";
        public const string Update = @"UPDATE membership_status SET status_name = @StatusName WHERE status_id = @StatusId";
        public const string Delete = @"DELETE FROM membership_status WHERE status_id = @StatusId";
    }
